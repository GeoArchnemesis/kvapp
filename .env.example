# Neon Postgres connection string (pooled, HTTP driver)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Asia/Tbilisi is fixed in application code (lib/utils/timezone.ts); no env var needed.

# --- Phase 2+ (stubbed locally until real values are supplied) ---
PAYMENT_PROVIDER="stub" # stub | tbc | bog
MEAL_PLAN_SELECTOR="deterministic" # deterministic | llm

SESSION_SECRET=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
N8N_WHATSAPP_WEBHOOK_URL=""

# --- Admin dashboard auth (Auth.js v5 magic-link, /admin) ---
# AUTH_SECRET: required by Auth.js; generate with `openssl rand -base64 32`.
# ADMIN_EMAILS: comma-separated allowlist — only these addresses can sign in
# to /admin. No public signup exists for this.
# MAILGUN_API_KEY / MAILGUN_DOMAIN above are reused for sending the magic
# link; until both are set, the link is only printed to the dev console.
# AUTH_URL: leave UNSET locally (an empty value, not just a blank default,
# actually breaks Auth.js host-trust checks — see .env.local's comment).
# Only set it in production, to your real deployed domain.
AUTH_SECRET=""
ADMIN_EMAILS=""
AUTH_URL=""
